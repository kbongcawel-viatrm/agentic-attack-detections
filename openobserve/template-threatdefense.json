[
  {
    "name": "threatdefense",
    "body": "<!DOCTYPE html>\n<html><body style=\"margin:0;padding:0;background:#0b1120;\">\n<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:640px;margin:0 auto;background:#0f172a;border-radius:10px;overflow:hidden;border:1px solid #1e293b;\">\n  <div style=\"background:linear-gradient(135deg,#0ea5e9,#6366f1);padding:24px;text-align:center;\">\n    <img src=\"https://files.catbox.moe/nnmnu0.png\" alt=\"Suricata\" width=\"180\" style=\"display:block;margin:0 auto 10px;\" />\n    <div style=\"color:#ffffff;font-size:20px;font-weight:bold;letter-spacing:2px;\">THREATDEFENSE</div>\n    <div style=\"color:#bae6fd;font-size:12px;margin-top:4px;\">Automated Detection Pipeline</div>\n  </div>\n  <div style=\"padding:24px;color:#e2e8f0;\">\n    <div style=\"display:inline-block;background:#dc2626;color:#fff;font-size:12px;font-weight:bold;padding:4px 12px;border-radius:20px;margin-bottom:12px;\">{alert_status}</div>\n    <h2 style=\"margin:0 0 6px;font-size:20px;color:#f8fafc;\">{alert_name}</h2>\n    <p style=\"margin:0 0 20px;color:#94a3b8;font-size:14px;\">Stream: <strong style=\"color:#e2e8f0;\">{stream_name}</strong> &nbsp;|&nbsp; Org: <strong style=\"color:#e2e8f0;\">{org_name}</strong></p>\n    <table style=\"width:100%;border-collapse:collapse;font-size:13px;margin-bottom:8px;\">\n      <tr><td style=\"padding:8px;border-bottom:1px solid #1e293b;color:#64748b;width:40%;\">Matching records</td><td style=\"padding:8px;border-bottom:1px solid #1e293b;color:#f8fafc;\">{alert_count}</td></tr>\n      <tr><td style=\"padding:8px;border-bottom:1px solid #1e293b;color:#64748b;\">Threshold</td><td style=\"padding:8px;border-bottom:1px solid #1e293b;color:#f8fafc;\">{alert_operator} {alert_threshold}</td></tr>\n      <tr><td style=\"padding:8px;border-bottom:1px solid #1e293b;color:#64748b;\">Triggered at</td><td style=\"padding:8px;border-bottom:1px solid #1e293b;color:#f8fafc;\">{alert_trigger_time_str}</td></tr>\n      <tr><td style=\"padding:8px;color:#64748b;\">Window</td><td style=\"padding:8px;color:#f8fafc;\">{alert_start_time} &rarr; {alert_end_time}</td></tr>\n    </table>\n    <h3 style=\"font-size:15px;color:#f8fafc;margin:16px 0 10px;\">Report details</h3>\n    <div style=\"background:#1e293b;border-radius:8px;padding:14px;font-size:13px;color:#cbd5e1;line-height:1.8;\">\n      <div><span style=\"color:#64748b;\">Report date:</span> <strong style=\"color:#f8fafc;\">{report_date}</strong></div>\n      <div><span style=\"color:#64748b;\">Verdict:</span> <strong style=\"color:#f8fafc;\">{verdict}</strong> &nbsp; <span style=\"color:#64748b;\">Confidence:</span> <strong style=\"color:#f8fafc;\">{confidence}</strong></div>\n      <div><span style=\"color:#64748b;\">Events assessed:</span> <strong style=\"color:#f8fafc;\">{total_events}</strong> &nbsp; <span style=\"color:#64748b;\">Window:</span> <strong style=\"color:#f8fafc;\">{window_hours}h</strong></div>\n      <div><span style=\"color:#64748b;\">Flagged IPs:</span> <strong style=\"color:#f8fafc;\">{flagged_ips}</strong></div>\n      <div><span style=\"color:#64748b;\">ARP suspicious:</span> <strong style=\"color:#f8fafc;\">{arp_suspicious}</strong> &nbsp; <span style=\"color:#64748b;\">Pending CF action:</span> <strong style=\"color:#f8fafc;\">{pending_cf_action}</strong> &nbsp; <span style=\"color:#64748b;\">CF submitted:</span> <strong style=\"color:#f8fafc;\">{cf_submitted}</strong></div>\n      <div><span style=\"color:#64748b;\">Subjects assessed:</span> <strong style=\"color:#f8fafc;\">{subjects_assessed}</strong></div>\n    </div>\n    <div style=\"background:#1e293b;border-radius:8px;padding:12px;font-size:12px;color:#cbd5e1;overflow-x:auto;margin-top:10px;line-height:1.7;\">{rows}</div>\n    <div style=\"text-align:center;margin-top:24px;\">\n      <a href=\"{alert_url}\" style=\"display:inline-block;background:#0ea5e9;color:#fff;text-decoration:none;font-size:14px;font-weight:bold;padding:12px 28px;border-radius:6px;\">Open in OpenObserve</a>\n    </div>\n  </div>\n  <div style=\"padding:16px;text-align:center;color:#475569;font-size:11px;border-top:1px solid #1e293b;\">Automated ThreatDefense detection &middot; {org_name}</div>\n</div>\n</body></html>",
    "isDefault": true,
    "isPrebuilt": false,
    "type": "email",
    "title": "ThreatDefense Alert: {alert_name} [{alert_status}]",
    "kind": "custom"
  }
]